{
  "id": "kinetic-title",
  "name": "Kinetic title (words rise out of a line mask)",
  "category": "text",
  "description": "A headline whose words rise one after another out of an invisible line window (a fixed comp-space mask), each word easing out cubic, with motion blur, an optional accent word in another colour / serif italic, and an optional exit up through the same window. The house title move.",
  "source": [
    "r02 S1/S5 kinetic type (per-word rise, easeOutCubic family, stagger 3-6 f at 60)",
    "r04 S3 word-by-word statement (reveals 3-8 f apart at 60)",
    "mcp/examples/build-a-kinetic-title.mjs (mask window, accent word)"
  ],
  "taste": [
    "TASTE.md 2 Easing",
    "3 Timing",
    "4 Stagger",
    "5 Typography"
  ],
  "params": {
    "text": {
      "type": "string",
      "description": "The headline. One line; use \\n for a second line (one layer, words cascade across lines)."
    },
    "x": {
      "type": "number",
      "default": null,
      "description": "Centre x in comp px (default: comp centre)."
    },
    "y": {
      "type": "number",
      "default": null,
      "description": "Centre y of the line box in comp px (default: comp centre)."
    },
    "size": {
      "type": "number",
      "default": null,
      "min": 8,
      "description": "Font size px. Default 9 % of the short side (TASTE 5: headlines 8-12 %)."
    },
    "weight": {
      "type": "number",
      "default": 700,
      "description": "Font weight (600-800 for titles)."
    },
    "family": {
      "type": "string",
      "default": "Inter",
      "description": "Font family (list_features catalogs.fontFamilies). Inter Tight / Archivo Expanded for display."
    },
    "color": {
      "type": "color",
      "default": "#0b0b0d",
      "description": "Text colour."
    },
    "tracking": {
      "type": "number",
      "default": -20,
      "description": "Tracking in 1/1000 em (After Effects units). Titles -10 to -30, never positive on big type."
    },
    "accentWord": {
      "type": "integer",
      "default": -1,
      "description": "0-based index of a word to accent (-1 = none)."
    },
    "accentColor": {
      "type": "color",
      "default": "#2f6bff",
      "description": "Accent word colour."
    },
    "accentFamily": {
      "type": "string",
      "default": "",
      "description": "Accent word family, e.g. 'Instrument Serif' for a true-italic serif accent ('' = same family)."
    },
    "accentItalic": {
      "type": "boolean",
      "default": false,
      "description": "Accent word in italic (use with a serif that has a true italic)."
    },
    "delay": {
      "type": "number",
      "default": 0,
      "min": 0,
      "description": "Frames at 30 fps from startFrame to the first word."
    },
    "entrance": {
      "type": "number",
      "default": 14,
      "min": 4,
      "description": "Per-word rise length, frames at 30 fps (TASTE 3: 12-16)."
    },
    "stagger": {
      "type": "number",
      "default": 3,
      "min": 0.5,
      "description": "Frames at 30 fps between word starts (TASTE 4: 2-6, median 3)."
    },
    "fade": {
      "type": "boolean",
      "default": false,
      "description": "Also fade each word in (off = a pure mask reveal, the cleaner look)."
    },
    "exit": {
      "type": "boolean",
      "default": true,
      "description": "Exit up through the window, ending on the end frame."
    },
    "exitFrames": {
      "type": "number",
      "default": 10,
      "min": 3,
      "description": "Exit length, frames at 30 fps (exits are faster than entrances)."
    },
    "motionBlur": {
      "type": "boolean",
      "default": true,
      "description": "Per-glyph motion blur on the rise."
    },
    "name": {
      "type": "string",
      "default": "Title",
      "description": "Layer name."
    },
    "maxWidth": {
      "type": "number",
      "default": null,
      "description": "Widest the line may be, px (default 84 % of the comp width: keeps the safe margins of TASTE 5). The size shrinks to fit."
    }
  },
  "length30": "delay + entrance + stagger * (len(words(text)) - 1) + 40 + (exit ? exitFrames : 0)",
  "checkFrames30": [
    "delay + entrance * 0.5",
    "delay + entrance + stagger * (len(words(text)) - 1)",
    "delay + entrance + stagger * (len(words(text)) - 1) + 20"
  ],
  "lets": {
    "X": "x == null ? CX : x",
    "Y": "y == null ? CY : y",
    "n": "len(words(text))",
    "E": "f(entrance)",
    "G": "max(1, stagger * fps / 30)",
    "w": "n > 1 ? E / (G * (n - 1)) : 1",
    "D": "n > 1 ? round(E + G * (n - 1)) : E",
    "s0": "start + f(delay)",
    "S0": "size == null ? round(min(W, H) * 0.09) : size"
  },
  "steps": [
    {
      "id": "fit",
      "action": "agent.measureString",
      "args": {
        "text": "{{text}}",
        "fontFamily": "{{family}}",
        "fontSize": "{{S0}}",
        "fontWeight": "{{weight}}",
        "letterSpacing": "{{round(S0 * tracking / 1000, 2)}}"
      }
    },
    {
      "let": {
        "S": "round(min(S0, S0 * (maxWidth == null ? W * 0.84 : maxWidth) / max(1, @fit.result.width)))"
      }
    },
    {
      "let": {
        "rise": "round(S * 1.3)",
        "pad": "round(S * 0.2)"
      }
    },
    {
      "id": "txt",
      "action": "editor.createQuickText",
      "args": {
        "x": "{{X - PX}}",
        "y": "{{Y - PY}}",
        "text": "{{text}}"
      },
      "layer": true,
      "root": true
    },
    {
      "let": {
        "L": "@txt.result"
      }
    },
    {
      "action": "editor.renameLayer",
      "args": {
        "id": "{{L}}",
        "name": "{{name}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "animOverrides.fontSize.defaultValue",
        "value": "{{S}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "content.spans.0.style.fontSize",
        "value": "{{S}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "content.spans.0.style.fontWeight",
        "value": "{{weight}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "content.spans.0.style.fontFamily",
        "value": "{{family}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "content.spans.0.style.color",
        "value": "{{color}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "animOverrides.letterSpacing.defaultValue",
        "value": "{{round(S * tracking / 1000, 2)}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "motionBlur",
        "value": "{{motionBlur}}"
      }
    },
    {
      "when": "accentWord >= 0",
      "action": "editor.styleTextWord",
      "args": {
        "layerId": "{{L}}",
        "wordIndex": "{{accentWord}}",
        "exclusive": true,
        "style": {
          "color": "{{accentColor}}",
          "fontFamily": "{{accentFamily == '' ? family : accentFamily}}",
          "fontStyle": "{{accentItalic ? 'italic' : 'normal'}}",
          "fontWeight": "{{accentFamily == '' ? weight : 400}}"
        }
      }
    },
    {
      "id": "m",
      "tool": "measure_text",
      "args": {
        "layerId": "{{L}}"
      }
    },
    {
      "action": "editor.addMask",
      "args": {
        "layerId": "{{L}}",
        "type": "rectangle"
      }
    },
    {
      "id": "lay",
      "tool": "get_layer",
      "args": {
        "layerId": "{{L}}"
      }
    },
    {
      "let": {
        "maskId": "@lay.result.masks[-1].id",
        "mTop": "@m.result.ink.top - pad",
        "mBot": "@m.result.ink.bottom + pad"
      }
    },
    {
      "action": "editor.updateMaskProperty",
      "args": {
        "layerId": "{{L}}",
        "maskId": "{{maskId}}",
        "path": "position.defaultValue",
        "value": "{{[@m.result.center[0], (mTop + mBot) / 2]}}"
      }
    },
    {
      "action": "editor.updateMaskProperty",
      "args": {
        "layerId": "{{L}}",
        "maskId": "{{maskId}}",
        "path": "size.defaultValue",
        "value": "{{[W * 3, mBot - mTop]}}"
      }
    },
    {
      "action": "agent.applyTextAnimatorPreset",
      "args": {
        "layerId": "{{L}}",
        "presetId": "rise-fade-word",
        "startFrame": "{{s0}}",
        "durationFrames": "{{D}}",
        "replace": true
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "animators.0.delta",
        "value": {
          "position": "{{[0, rise]}}",
          "opacity": "{{fade ? -1 : 0}}"
        }
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "animators.0.selector.end",
        "value": "{{w}}"
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "animators.0.selector.easeLow",
        "value": 1
      }
    },
    {
      "action": "editor.updateLayerProperty",
      "args": {
        "layerId": "{{L}}",
        "path": "animators.0.selector.easeHigh",
        "value": 0
      }
    },
    {
      "action": "editor.setKeyframes",
      "args": {
        "layerId": "{{L}}",
        "propertyPath": "animators.0.offset",
        "keyframes": [
          {
            "frame": "{{s0}}",
            "value": "{{-w}}",
            "ease": "linear"
          },
          {
            "frame": "{{s0 + D}}",
            "value": "{{n > 1 ? 1 : 0}}"
          }
        ]
      }
    },
    {
      "when": "exit",
      "action": "editor.setKeyframes",
      "args": {
        "layerId": "{{L}}",
        "propertyPath": "transform.position",
        "keyframes": [
          {
            "frame": "{{end - f(exitFrames)}}",
            "value": "{{[X - PX, Y - PY]}}",
            "ease": [
              0.7,
              0,
              0.84,
              0
            ]
          },
          {
            "frame": "{{end}}",
            "value": "{{[X - PX, Y - PY - rise]}}"
          }
        ]
      }
    }
  ],
  "returns": {
    "layerId": "{{L}}",
    "inkTop": "{{@m.result.ink.top}}",
    "inkBottom": "{{@m.result.ink.bottom}}",
    "inkWidth": "{{@m.result.ink.width}}",
    "settledFrame": "{{s0 + D}}"
  },
  "example": {
    "params": {
      "text": "Motion, built by Claude",
      "accentWord": 3,
      "accentFamily": "Instrument Serif",
      "accentItalic": true
    },
    "startFrame": 6
  }
}