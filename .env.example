# FlashFX environment variables. Copy to `.env` and fill in. NEVER commit `.env` (it's gitignored).
# All VITE_* values are exposed in the browser bundle — only put PUBLIC / publishable values here.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project Settings → API. The anon key is public/publishable (safe in the bundle).
# Do NOT put the service_role key here — it's server-only.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key (starts with eyJ… or sb_publishable_…)>

# ── Social sign-in (optional) ────────────────────────────────────────────────
# The "Continue with Google" button shows by default; set this to "false" to hide it.
# Google's CLIENT ID + SECRET are NOT set here — you paste them into the Supabase
# dashboard (Authentication → Providers → Google). See docs/AUTH-SETUP.md.
# (Microsoft and Apple sign-in were removed; email/password is the other method.)
VITE_OAUTH_GOOGLE=true

# ── Lemon Squeezy billing (optional; billing turns ON only when the checkout URL is set) ─
# The Pro variant's hosted checkout link (public, safe in the bundle). Its presence enables billing.
# Products -> your variant -> Share. Test mode and live have SEPARATE links. See docs/LEMON-SQUEEZY-SETUP.md.
VITE_LEMON_CHECKOUT_URL=
# Optional display price on the upgrade CTA (must match the LS variant price).
VITE_LEMON_PRICE_LABEL=$29.99/mo
# Optional; not needed for the hosted-checkout overlay, kept for future API-created checkouts.
VITE_LEMON_VARIANT_ID=

# ── Observability (optional; inert until set) ────────────────────────────────
# Error monitoring + product analytics. With neither set, telemetry stays console-only. Both values are
# public/publishable (safe in the bundle). See docs/DEPLOYMENT.md "Monitoring".
# Sentry DSN (crash reports). Project Settings -> Client Keys (DSN) in Sentry.
VITE_SENTRY_DSN=
# PostHog project API key (product analytics; only sends after the user grants analytics consent).
VITE_POSTHOG_KEY=
# Optional PostHog host (default https://us.i.posthog.com; use https://eu.i.posthog.com for EU).
VITE_POSTHOG_HOST=

# ── Local AI runs (node scripts only — NOT the browser) ──────────────────────
# scripts/director-run.mjs / coder-run.mjs read this from your shell env for real
# model runs. NEVER prefix it VITE_ (that would bundle the key into the browser).
# The in-app AI uses a browser BYOK key stored in localStorage, not this var.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Edge-function secrets (NOT set here — set with `supabase secrets set …`) ────
# These live on the Supabase edge functions, never in the browser bundle:
#   LEMON_SQUEEZY_SIGNING_SECRET — Lemon Squeezy webhook signing secret (Settings -> Webhooks).
#                             Test and live webhooks have DIFFERENT secrets.
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY — injected automatically by Supabase.
#   GOOGLE_SERVICE_ACCOUNT_JSON — only for the (currently disabled) Drive proxy.
